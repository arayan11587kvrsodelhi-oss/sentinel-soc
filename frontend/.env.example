# SentinelSOC Frontend Environment Configuration

# Backend REST API base URL (in development defaults to http://localhost:8000)
# In production set to your deployed backend (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket base URL (in development defaults to ws://localhost:8000/ws/events)
# In production set to wss://your-backend.onrender.com/ws/events
VITE_WS_BASE_URL=ws://localhost:8000/ws/events
