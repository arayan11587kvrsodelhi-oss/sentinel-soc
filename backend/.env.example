# SentinelSOC Backend Configuration

# Database Connection (Optional SQLite default)
DATABASE_URL=sqlite:///./sentinel.db

# National Vulnerability Database (NVD) API Key (Optional, increases NIST rate limits)
NVD_API_KEY=

# CORS Allowed Origins (Comma-separated list of additional allowed origins)
CORS_ORIGINS=https://sentinel-soc-gamma.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:5175

# AI Defensive Analyst LLM Integration (Optional - falls back to built-in expert rule engine)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

